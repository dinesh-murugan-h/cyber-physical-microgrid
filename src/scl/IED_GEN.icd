<?xml version="1.0" encoding="UTF-8"?>
<SCL xmlns="http://www.iec.ch/61850/2003/SCL"
     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:schemaLocation="http://www.iec.ch/61850/2003/SCL SCL.xsd">

  <Header id="IED_GEN1" nameStructure="FuncName" version="1.1" revision="1"/>

  <!-- ====================== Communication ====================== -->
  <Communication>
    <SubNetwork name="StationBus" type="8-MMS">
      <Text>Generator MMS Network</Text>
      <BitRate unit="b/s">10000000</BitRate>
      <ConnectedAP iedName="IED_GEN1" apName="AP1">
        <Address>
          <P type="IP">10.0.0.10</P>
          <P type="IP-SUBNET">255.255.255.0</P>
          <P type="IP-GATEWAY">10.0.0.1</P>
          <P type="OSI-TSEL">0001</P>
          <P type="OSI-PSEL">00000001</P>
          <P type="OSI-SSEL">0001</P>
        </Address>
      </ConnectedAP>
    </SubNetwork>
  </Communication>

  <!-- ====================== Substation ====================== -->
  <Substation name="GEN_SUB">
    <VoltageLevel name="GEN_BUS">
      <Bay name="GEN_BAY">
        <ConductingEquipment name="GEN1" type="GEN">
          <LNode lnClass="MMXU" lnInst="1"/>
        </ConductingEquipment>
      </Bay>
    </VoltageLevel>
  </Substation>

  <!-- ====================== IED Definition ====================== -->
  <IED name="IED_GEN1">
    <AccessPoint name="AP1">
      <Server>
        <Authentication/>

        <LDevice inst="GEN1">
          <!-- LLN0 logical node -->
          <LN0 lnClass="LLN0" lnType="GEN_LLN0" inst="">
            <DataSet name="GenMeasDS">
              <FCDA ldInst="GEN1" lnClass="MMXU" lnInst="1" fc="MX" doName="PhV"/>
              <FCDA ldInst="GEN1" lnClass="MMXU" lnInst="1" fc="MX" doName="A"/>
              <FCDA ldInst="GEN1" lnClass="MMXU" lnInst="1" fc="MX" doName="Hz"/>
              <FCDA ldInst="GEN1" lnClass="MMXU" lnInst="1" fc="MX" doName="TotW"/>
            </DataSet>

            <ReportControl name="GenReport" rptID="GEN1_RPT01"
                           datSet="GenMeasDS" confRev="1"
                           buffered="false" intgPd="1000">
              <TrgOps dchg="true" qchg="true" per="true"/>
              <OptFields seqNum="true" timeStamp="true" dataSet="true"
                         reasonCode="true" dataRef="true" entryID="false"
                         configRef="false"/>
              <RptEnabled max="2">
                <ClientLN iedName="" ldInst="" lnClass="" lnInst=""/>
              </RptEnabled>
            </ReportControl>
          </LN0>

          <!-- MMXU Logical Node -->
          <LN lnClass="MMXU" inst="1" lnType="GEN_MMXU"/>
        </LDevice>

      </Server>
    </AccessPoint>
  </IED>

  <!-- ====================== Data Type Templates ====================== -->
  <DataTypeTemplates>

    <!-- LLN0 -->
    <LNodeType id="GEN_LLN0" lnClass="LLN0">
      <DO name="Mod" type="GEN_INC"/>
    </LNodeType>

    <!-- MMXU -->
    <LNodeType id="GEN_MMXU" lnClass="MMXU">
      <DO name="PhV" type="GEN_WYE_V"/>
      <DO name="A"   type="GEN_WYE_I"/>
      <DO name="Hz"  type="GEN_SAVHz"/>
      <DO name="TotW" type="GEN_SAVW"/>
    </LNodeType>

    <!-- ============ DO Types ============ -->
    <DOType id="GEN_WYE_V" cdc="WYE">
      <DA name="phsA" bType="Struct" type="GEN_AV" fc="MX"/>
      <DA name="phsB" bType="Struct" type="GEN_AV" fc="MX"/>
      <DA name="phsC" bType="Struct" type="GEN_AV" fc="MX"/>
      <DA name="neut" bType="Struct" type="GEN_AV" fc="MX"/>
      <DA name="q" bType="Quality" fc="MX"/>
      <DA name="t" bType="Timestamp" fc="MX"/>
    </DOType>

    <DOType id="GEN_WYE_I" cdc="WYE">
      <DA name="phsA" bType="Struct" type="GEN_AV" fc="MX"/>
      <DA name="phsB" bType="Struct" type="GEN_AV" fc="MX"/>
      <DA name="phsC" bType="Struct" type="GEN_AV" fc="MX"/>
      <DA name="neut" bType="Struct" type="GEN_AV" fc="MX"/>
      <DA name="q" bType="Quality" fc="MX"/>
      <DA name="t" bType="Timestamp" fc="MX"/>
    </DOType>

    <DOType id="GEN_SAVHz" cdc="SAV">
      <DA name="instMag" bType="Struct" type="GEN_AV" fc="MX"/>
      <DA name="q" bType="Quality" fc="MX"/>
      <DA name="t" bType="Timestamp" fc="MX"/>
    </DOType>

    <DOType id="GEN_SAVW" cdc="SAV">
      <DA name="instMag" bType="Struct" type="GEN_AV" fc="MX"/>
      <DA name="q" bType="Quality" fc="MX"/>
      <DA name="t" bType="Timestamp" fc="MX"/>
    </DOType>

    <DOType id="GEN_INC" cdc="INC">
      <DA name="stVal" fc="ST" bType="INT32" dchg="true"/>
      <DA name="q" fc="ST" bType="Quality" dchg="true"/>
      <DA name="t" fc="ST" bType="Timestamp" dchg="true"/>
    </DOType>

    <!-- ============ DA/BDA Types ============ -->
    <DAType id="GEN_AV">
      <BDA name="mag" bType="Struct" type="GEN_FLOAT"/>
      <BDA name="q" bType="Quality"/>
      <BDA name="t" bType="Timestamp"/>
    </DAType>

    <DAType id="GEN_FLOAT">
      <BDA name="f" bType="FLOAT32"/>
    </DAType>

  </DataTypeTemplates>
</SCL>
